{
  "name": "agent-obs-cli",
  "version": "0.1.0",
  "description": "Agent-friendly CLI for safely querying and transferring Huawei Cloud OBS objects.",
  "type": "module",
  "bin": {
    "agent-obs-cli": "bin/agent-obs-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "config",
    "README.md",
    "README_EN.md",
    "AI_INSTALL.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "keywords": [
    "huawei-cloud",
    "obs",
    "object-storage",
    "cli",
    "agent",
    "skill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Allenskoo856/agent-obs-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "fast-xml-parser": "5.10.1"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "esdk-obs-nodejs": "^3.26.2",
    "p-limit": "^7.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
